# Supabase — copy to .env.local and fill in from Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# App URL (used for auth redirects, e.g. password reset)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# NEVER expose the service-role key to the browser. Not needed for V1.
# SUPABASE_SERVICE_ROLE_KEY=
